#!/bin/sh
# Blackthornes Tradeskills -- pre-commit
#
# Stops your own saved data reaching the repository. Install once per clone:
#
#     git config core.hooksPath .githooks
#
# or run tools/install-hooks.ps1.

SNAPSHOT='Data/Snapshot.lua'

# Not staging the snapshot, nothing to check.
git diff --cached --name-only --diff-filter=ACM | grep -Fxq "$SNAPSHOT" || exit 0

if git show ":$SNAPSHOT" | sh tools/check-snapshot.sh; then
    exit 0
fi

cat >&2 <<'MSG'

  Commit refused: Data/Snapshot.lua holds saved data.

  That file contains your characters, your prices and your auctions. It ships
  empty and must stay empty here.

  To commit the rest of your work, unstage it:

      git restore --staged Data/Snapshot.lua

  To put the empty version back:

      git checkout -- Data/Snapshot.lua

  Your deployed copy in Interface\AddOns is untouched either way, so the
  snapshot keeps working in game.

MSG
exit 1
